void criarBD(char bdnome[100])
{
    DIR* dir;
    struct dirent* entrada;
    char pasta_bd[110];

    snprintf(pasta_bd, sizeof(pasta_bd), "%s_bd", bdnome);

    if (mkdir(pasta_bd, 0777) == 0)
    {
        printf("Banco de Dados criado\n");
    }
    else
    {
        printf("Erro ao criar o Banco de Dados.\n");
    }

    dir = opendir(pasta_bd);

    if (dir == NULL)
    {
        printf("Não foi possível abrir a pasta.\n");
        return;
    }

    while ((entrada = readdir(dir)) != NULL)
    {
        if (strcmp(entrada->d_name, ".") != 0 && strcmp(entrada->d_name, "..") != 0)printf("%s\n", entrada->d_name);
    }

    closedir(dir);

    if (strlen(pasta_bd) == 0) {
        printf("BD nao inicializado!\n");
        return;
    }

    entrarBD(pasta_bd);

    return;
}

