char bdAtual[100], caminhobd_tb[220];

struct professor
{
    char sala[50];
    char nome[100];
    char materia[50];
};

void copiarArquivo(FILE* origem, FILE* destino)
{
    char linha[256];

    while (fgets(linha, sizeof(linha), origem))
    {
        fputs(linha, destino);
    }
}

int contagem(FILE* Tb_ptr)
{
    char linha[256];
    int id_ext, id_valid = 0;

    rewind(Tb_ptr);

    while (fgets(linha, sizeof(linha), Tb_ptr))
    {
        if (sscanf(linha, "id: %d", &id_ext) == 1)
        {
            if (id_ext > id_valid)
                id_valid = id_ext;
        }
    }

    return id_valid + 1;
}

void remover(const int id_alvo)
{
    FILE* orig = fopen(caminhobd_tb, "r");
    FILE* temp = fopen("temp.txt", "w");

    if (!orig || !temp) {
        printf("Erro ao abrir arquivos\n");
        if (orig) fclose(orig);
        if (temp) fclose(temp);
        return;
    }

    char linha[256];
    int id;

    while (fgets(linha, sizeof(linha), orig))
    {
        if (sscanf(linha, "id: %d", &id) == 1 && id == id_alvo)
            continue;

        fputs(linha, temp);
    }

    fclose(orig);
    fclose(temp);

    remove(caminhobd_tb);
    rename("temp.txt", caminhobd_tb);

    printf("Professor removido com sucesso!\n");
}

void mudanca(const char dadotipo, const char novoDado[100], const int id_alvo)
{
    FILE* orig = fopen(caminhobd_tb, "r");
    FILE* temp = fopen("temp.txt", "w");

    if (!orig || !temp) {
        printf("Erro ao abrir arquivos\n");
        return;
    }

    char linha[256];
    int id;
    char nome[100], materia[50], sala[50];

    while (fgets(linha, sizeof(linha), orig))
    {
        if (sscanf(linha,
            "id: %d, nome: %99[^,], materia: %49[^,], sala: %49[^\n]",
            &id, nome, materia, sala) != 4)
        {
            fputs(linha, temp);
            continue;
        }

        if (id == id_alvo)
        {
            if (dadotipo == 'n') strcpy(nome, novoDado);
            else if (dadotipo == 'm') strcpy(materia, novoDado);
            else if (dadotipo == 's') strcpy(sala, novoDado);
        }

        fprintf(temp,
            "id: %d, nome: %s, materia: %s, sala: %s\n",
            id, nome, materia, sala);
    }

    fclose(orig);
    fclose(temp);

    remove(caminhobd_tb);
    rename("temp.txt", caminhobd_tb);

    printf("Dados alterados com sucesso!\n");
}

void alterar()
{
    char acabou_alterando = 'n';
    char alteracao;
    char novoDado[100];
    int id_alvo;

    do
    {
        printf("Quer alterar nome, materia ou sala? (n/m/s)\n");
        scanf(" %c", &alteracao);

        printf("Qual é o id?\n");
        scanf("%d", &id_alvo);

        while (getchar() != '\n'); // FIX BUFFER

        switch (alteracao)
        {
        case 'n':
            printf("Qual é o novo nome?\n");
            fgets(novoDado, sizeof(novoDado), stdin);
            break;

        case 'm':
            printf("Qual é a nova matéria?\n");
            fgets(novoDado, sizeof(novoDado), stdin);
            break;

        case 's':
            printf("Qual é a nova sala?\n");
            fgets(novoDado, sizeof(novoDado), stdin);
            break;

        default:
            printf("Opção inválida\n");
            continue;
        }

        novoDado[strcspn(novoDado, "\n")] = '\0';

        mudanca(alteracao, novoDado, id_alvo);

        printf("Deseja continuar alterando? (s/n)\n");
        scanf(" %c", &acabou_alterando);

    } while (acabou_alterando == 's');
}

void procuraTB(FILE* Tb_ptr)
{
    if (Tb_ptr == NULL)
    {
        printf("Erro, tabela não encontrada\n");
        return;
    }

    rewind(Tb_ptr);

    char nome_ext[100];
    char sala_ext[50];
    char materia_ext[50];
    char profAlvo[100];

    int id_ext;

    char especifico;
    char linha[256];

    printf("Procurar alguém específico? (s/n)\n");
    scanf(" %c", &especifico);

    if (especifico == 'n')
    {
        while (fgets(linha, sizeof(linha), Tb_ptr))
        {
            printf("%s", linha);
        }
    }
    else
    {
        printf("Qual professor deseja procurar?\n");

        getchar();

        fgets(profAlvo, sizeof(profAlvo), stdin);
        profAlvo[strcspn(profAlvo, "\n")] = '\0';

        while (fgets(linha, sizeof(linha), Tb_ptr))
        {
            if (sscanf(linha,
                "id: %d, nome: %99[^,], materia: %49[^,], sala: %49[^\n]",
                &id_ext,
                nome_ext,
                materia_ext,
                sala_ext) == 4)
            {
                if (strcmp(nome_ext, profAlvo) == 0)
                {
                    printf("%s", linha);
                }
            }
        }

        printf("Professor não encontrado.\n");
    }
}

void cadastroTB(FILE* Tb_ptr)
{
    struct professor prof;
    int id_novo;

    if (!Tb_ptr)
    {
        printf("Erro, tabela não encontrada\n");
        return;
    }

    printf("Coloque o nome do professor:\n");
    while (getchar() != '\n');
    fgets(prof.nome, sizeof(prof.nome), stdin);
    prof.nome[strcspn(prof.nome, "\n")] = '\0';

    printf("Coloque a matéria:\n");
    fgets(prof.materia, sizeof(prof.materia), stdin);
    prof.materia[strcspn(prof.materia, "\n")] = '\0';

    printf("Coloque a sala:\n");
    fgets(prof.sala, sizeof(prof.sala), stdin);
    prof.sala[strcspn(prof.sala, "\n")] = '\0';

    id_novo = contagem(Tb_ptr);

    fseek(Tb_ptr, 0, SEEK_END);

    fprintf(Tb_ptr,
        "id: %d, nome: %s, materia: %s, sala: %s\n",
        id_novo,
        prof.nome,
        prof.materia,
        prof.sala);

    fflush(Tb_ptr);

    printf("Professor cadastrado com sucesso!\n");
}

void abrirTB(char filename[110])
{
    FILE* salas;
    char cad_pro, acabou;
    int id_alvo;

    snprintf(caminhobd_tb, sizeof(caminhobd_tb),
             "%s/%s.txt", bdAtual, filename);

    salas = fopen(caminhobd_tb, "a+");

    if (!salas) {
        printf("Erro ao abrir tabela!\n");
        return;
    }

    do
    {
        printf("cadastrar / procurar / alterar / remover o professor (c/p/a/r)\n");
        scanf(" %c", &cad_pro);

        switch (cad_pro)
        {
        case 'c':
            cadastroTB(salas);
            break;

        case 'p':
            procuraTB(salas);
            break;

        case 'a':
            alterar();
            break;

        case 'r':
            printf("ID: ");
            scanf("%d", &id_alvo);
            remover(id_alvo);
            break;
        }

        printf("Continuar? (s/n)\n");
        scanf(" %c", &acabou);

    } while (acabou == 's');

    fclose(salas);
}

