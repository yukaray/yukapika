void procurarSala()
{
    DIR* d;
    struct dirent* dir;

    char caminho[220];
    int encontrou = 0;

    if (strlen(bdAtual) == 0)
    {
        printf("BD nao inicializado!\n");
        return;
    }

    d = opendir(bdAtual);

    if (!d)
    {
        printf("Erro ao abrir banco de dados\n");
        return;
    }

    printf("\nCursos encontradas:\n");

    while ((dir = readdir(d)) != NULL)
    {
        if (strcmp(dir->d_name, ".") != 0 &&
            strcmp(dir->d_name, "..") != 0 &&
            strstr(dir->d_name, ".txt") != NULL)
        {
            printf("- %s\n", dir->d_name);
            encontrou = 1;
        }
    }

    if (!encontrou)
        printf("Nenhum curso encontrado.\n");

    closedir(d);
}

void criarSala()
{
    FILE* salas;

    char nomeSala[110];
    char caminho[220];

    printf("Digite o nome do curso: ");
    scanf(" %s", nomeSala);

    if (strlen(bdAtual) == 0)
    {
        printf("BD nao inicializado!\n");
        return;
    }

    snprintf(caminho, sizeof(caminho),
        "%s/%s.txt", bdAtual, nomeSala);

    salas = fopen(caminho, "a+");

    if (salas == NULL)
    {
        printf("Erro ao cadastrar curso!\n");
        return;
    }

    fclose(salas);

    printf("Sala '%s' criada com sucesso!\n", nomeSala);

    entrarSala(nomeSala);
}

