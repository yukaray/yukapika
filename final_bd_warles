static void criar_bloco_visual_bd(AppData *app, const char *titulo)
{
    GtkWidget *overlay = gtk_overlay_new();
    gtk_widget_set_size_request(overlay, 150, 150);
    gtk_widget_set_halign(overlay, GTK_ALIGN_START);
    gtk_widget_set_valign(overlay, GTK_ALIGN_START);
    
    char exibicao[120];
    g_strlcpy(exibicao, titulo, sizeof(exibicao));
    if (g_str_has_suffix(exibicao, "_bd")) {
        exibicao[strlen(exibicao) - 3] = '\0';
    }

    GtkWidget *btn_bd = gtk_button_new();
    gtk_widget_set_sensitive(btn_bd, !app->modo_exclusao);
    gtk_widget_set_hexpand(btn_bd, TRUE);
    gtk_widget_set_vexpand(btn_bd, TRUE);
    
    gtk_widget_add_css_class(btn_bd, "flat");

    GtkWidget *box_interno = gtk_box_new(GTK_ORIENTATION_VERTICAL, 6); 
    gtk_widget_set_halign(box_interno, GTK_ALIGN_CENTER);
    gtk_widget_set_valign(box_interno, GTK_ALIGN_CENTER);

    // USANDO ÍCONE NATIVO SIMBÓLICO (Sem arquivos externos e totalmente limpo)
    GtkWidget *icone_bd = gtk_image_new_from_icon_name("drive-harddisk");
    gtk_image_set_pixel_size(GTK_IMAGE(icone_bd), 72); 

    GtkWidget *lbl_texto = gtk_label_new(exibicao);

    gtk_box_append(GTK_BOX(box_interno), icone_bd);
    gtk_box_append(GTK_BOX(box_interno), lbl_texto);
    
    gtk_button_set_child(GTK_BUTTON(btn_bd), box_interno);

    // Mantém o ID da pasta vinculado para que a navegação de salas funcione perfeitamente
    g_object_set_data_full(G_OBJECT(btn_bd), "id_pasta", g_strdup(titulo), g_free);

    g_signal_connect(btn_bd, "clicked", G_CALLBACK(btn_bd_clicked), app);
    gtk_overlay_set_child(GTK_OVERLAY(overlay), btn_bd);

    GtkWidget *check = gtk_check_button_new();
    gtk_widget_set_visible(check, app->modo_exclusao);
    gtk_widget_set_can_target(check, app->modo_exclusao);
    gtk_widget_set_hexpand(check, FALSE);
    gtk_widget_set_vexpand(check, FALSE);
    gtk_widget_set_halign(check, GTK_ALIGN_END);
    gtk_widget_set_valign(check, GTK_ALIGN_START);
    gtk_widget_set_margin_top(check, 8);
    gtk_widget_set_margin_end(check, 8);

    char *nome = g_strdup(titulo);
    g_object_set_data_full(G_OBJECT(check), "id", nome, g_free);

    app->checks = g_list_append(app->checks, check);
    app->botoes = g_list_append(app->botoes, btn_bd);

    gtk_overlay_add_overlay(GTK_OVERLAY(overlay), check);
    gtk_flow_box_insert(GTK_FLOW_BOX(app->container_bd), overlay, -1);
}

