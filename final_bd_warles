    g_object_set_data_full(G_OBJECT(btn_prof), "prof_nome", g_strdup(nome), g_free);
    g_object_set_data_full(G_OBJECT(btn_prof), "prof_materia", g_strdup(materia), g_free);
    g_signal_connect(btn_prof, "clicked", G_CALLBACK(popup_editarProfessor), app);

    g_object_set_data(G_OBJECT(check), "prof_id", GINT_TO_POINTER(id));

    app->checks_dados = g_list_append(app->checks_dados, check);
    app->botoes_dados = g_list_append(app->botoes_dados, btn_prof);

    gtk_grid_attach(GTK_GRID(app->tabela), lbl_id, 0, app->num_linhas, 1, 1);
    gtk_grid_attach(GTK_GRID(app->tabela), btn_prof, 1, app->num_linhas, 1, 1);
    gtk_grid_attach(GTK_GRID(app->tabela), check, 2, app->num_linhas, 1, 1);

    app->num_linhas++;
}

