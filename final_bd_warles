    gtk_center_box_set_end_widget(GTK_CENTER_BOX(nav_tabela), box_btn_tabela);
    
    gtk_box_append(GTK_BOX(pagina_tabela), nav_tabela);
    gtk_box_append(GTK_BOX(pagina_tabela), overlay_tabela);

    /* ----- ADICIONANDO PÁGINAS AO STACK ----- */
    gtk_stack_add_named(GTK_STACK(stack), pagina_bd, "menu_bd");
