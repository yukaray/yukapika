char BASE_DIR[PATH_MAX];

void init_base_dir(void) 
{
    const char *docs = g_get_user_special_dir(G_USER_DIRECTORY_DOCUMENTS);
    if (!docs) {
        docs = g_get_home_dir(); 
    }
    snprintf(BASE_DIR, sizeof(BASE_DIR), "%s/banco_do_Yuka", docs);
    g_mkdir_with_parents(BASE_DIR, 0755);
}

int obter_proximo_id(const char *caminho) {
    char caminho_seq[PATH_MAX];
    g_strlcpy(caminho_seq, caminho, sizeof(caminho_seq));
    char *dot = strrchr(caminho_seq, '.');
    if (dot) {
        strcpy(dot, ".seq");
    } else {
        strcat(caminho_seq, ".seq");
    }

    int prox_id = 1;
    FILE *f = fopen(caminho_seq, "r");
    if (f) {
        if (fscanf(f, "%d", &prox_id) != 1) {
            prox_id = 1;
        }
        fclose(f);
    } else {
        FILE *f_txt = fopen(caminho, "r");
        if (f_txt) {
            char linha[256];
            int max_id = 0;
            while (fgets(linha, sizeof(linha), f_txt)) {
                int id;
                if (sscanf(linha, "id: %d;", &id) == 1) {
                    if (id > max_id) max_id = id;
                }
            }
            fclose(f_txt);
            prox_id = max_id + 1;
        }
    }

    f = fopen(caminho_seq, "w");
    if (f) {
        fprintf(f, "%d\n", prox_id + 1);
        fclose(f);
    }

    return prox_id;
}

