void tratar_excluir(GtkButton *btn, gpointer data)
{
    AppData *app = data;
    for (GList *l = app->checks; l != NULL; l = l->next) {
        GtkWidget *check = l->data;
        if (gtk_check_button_get_active(GTK_CHECK_BUTTON(check))) {
            const char *id = g_object_get_data(G_OBJECT(check), "id");
            if (id) {
                char caminho[PATH_MAX];
                snprintf(caminho, sizeof(caminho), "%s/%s", BASE_DIR, id);
                removerArquivo(caminho, GTK_WINDOW(app->win));
            }
        }
    }
    desativar_check_exc(btn, data);
    procurarBD(NULL, app);
}

void tratar_excluir_sala(GtkButton *btn, gpointer data)
{
    AppData *app = data;
    for (GList *l = app->checks_salas; l != NULL; l = l->next) {
        GtkWidget *check = l->data;
        if (gtk_check_button_get_active(GTK_CHECK_BUTTON(check))) {
            const char *id = g_object_get_data(G_OBJECT(check), "id");
            if (id) {
                char caminho[PATH_MAX];
                snprintf(caminho, sizeof(caminho), "%s/%s", app->bdAtual, id);
                removerArquivo(caminho, GTK_WINDOW(app->win));

                char *dot = strrchr(caminho, '.');
                if (dot) {
                    strcpy(dot, ".seq");
                    remove(caminho);
                }
            }
        }
    }
    btn_excluir_sala_clicked(btn, data); 
    procurarSalas(app);
}

void tratar_excluir_dado(GtkButton *btn, gpointer data)
{
    AppData *app = data;
    GList *ids_deletar = NULL;

    for (GList *l = app->checks_dados; l != NULL; l = l->next) {
        GtkWidget *check = l->data;
        if (gtk_check_button_get_active(GTK_CHECK_BUTTON(check))) {
            gpointer id_ptr = g_object_get_data(G_OBJECT(check), "prof_id");
            ids_deletar = g_list_append(ids_deletar, id_ptr);
        }
    }

    if (ids_deletar != NULL) {
        char caminho_temp[PATH_MAX];
        snprintf(caminho_temp, sizeof(caminho_temp), "%s.tmp", app->bdAtual);
        
        FILE *fin = fopen(app->bdAtual, "r");
        FILE *fout = fopen(caminho_temp, "w");

        if (fin && fout) {
            char linha[256];
            while (fgets(linha, sizeof(linha), fin)) {
                int id;
                if (sscanf(linha, "id: %d;", &id) == 1) {
                    gboolean pular = FALSE;
                    for (GList *d = ids_deletar; d != NULL; d = d->next) {
                        if (GPOINTER_TO_INT(d->data) == id) {
                            pular = TRUE;
                            break;
                        }
                    }
                    if (!pular) {
                        fputs(linha, fout);
                    }
                }
            }
        }
        if (fin) fclose(fin);
        if (fout) fclose(fout);

        remove(app->bdAtual);
        rename(caminho_temp, app->bdAtual);
        g_list_free(ids_deletar);
    }

    desativar_check_exc_dado(btn, app);
    procurarDados(app);
}

