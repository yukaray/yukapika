static void on_btn_procurar_clicked(GtkButton *btn, gpointer data) {
    AppData *app = data;
    gboolean visivel = gtk_widget_get_visible(app->campo_busca);

    if (visivel) {
        gtk_widget_set_visible(app->campo_busca, FALSE);
        gtk_entry_set_placeholder_text(GTK_ENTRY(app->campo_busca), "");
        gtk_editable_set_text(GTK_EDITABLE(app->campo_busca), ""); 
    } else {
        gtk_widget_set_visible(app->campo_busca, TRUE);
        gtk_entry_set_placeholder_text(GTK_ENTRY(app->campo_busca), "Digite o que procura...");
        gtk_widget_grab_focus(app->campo_busca);
    }
}

void criarBD(GtkButton *btn, gpointer data)
{
    AppData *app = data;
    GtkWidget *entry = g_object_get_data(G_OBJECT(btn), "entry");
    if (!entry) return;

    const char *texto = gtk_editable_get_text(GTK_EDITABLE(entry));
    if (!texto || strlen(texto) == 0) return;

    char nome[100];
    strncpy(nome, texto, sizeof(nome));
    nome[sizeof(nome)-1] = '\0';
    for (int i = 0; nome[i]; i++) if (nome[i] == ' ') nome[i] = '_';

    char pasta[PATH_MAX];
    snprintf(pasta, sizeof(pasta), "%s/%s_bd", BASE_DIR, nome);

    if (g_mkdir_with_parents(pasta, 0755) == 0) {
        gtk_window_destroy(GTK_WINDOW(app->popup));
        procurarBD(NULL, app);
    }
}

void criarSala(GtkButton *btn, gpointer data)
{
    AppData *app = data;
    GtkWidget *entry = g_object_get_data(G_OBJECT(btn), "entry");
    if (!entry) return;

    const char *texto = gtk_editable_get_text(GTK_EDITABLE(entry));
    if (!texto || strlen(texto) == 0) return;

    char caminho_arquivo[PATH_MAX];
    snprintf(caminho_arquivo, sizeof(caminho_arquivo), "%s/%s.txt", app->bdAtual, texto);

    FILE *f = fopen(caminho_arquivo, "a+");
    if (f) {
        fclose(f);
        gtk_window_destroy(GTK_WINDOW(app->popup));
        procurarSalas(app);
    }
}

void salvarProfessor(GtkButton *btn, gpointer data)
{
    AppData *app = data;

    GtkWidget *entry_nome = g_object_get_data(G_OBJECT(btn), "campo_nome");
    GtkWidget *entry_materia = g_object_get_data(G_OBJECT(btn), "campo_materia");

    if (!entry_nome || !entry_materia) return;

    const char *txt_nome = gtk_editable_get_text(GTK_EDITABLE(entry_nome));
    const char *txt_materia = gtk_editable_get_text(GTK_EDITABLE(entry_materia));

    if (strlen(txt_nome) == 0 || strlen(txt_materia) == 0) return; 

    int proximo_id = obter_proximo_id(app->bdAtual);

    FILE *f = fopen(app->bdAtual, "a+");
    if (f) {
        fprintf(f, "id: %d; nome: %s; matéria: %s;\n", proximo_id, txt_nome, txt_materia);
        fclose(f);

        gtk_window_destroy(GTK_WINDOW(app->popup));
        procurarDados(app); 
    }
}

void salvarAlteracaoProfessor(GtkButton *btn, gpointer data)
{
    AppData *app = data;
    GtkWidget *entry_nome = g_object_get_data(G_OBJECT(btn), "campo_nome");
    GtkWidget *entry_materia = g_object_get_data(G_OBJECT(btn), "campo_materia");
    int target_id = GPOINTER_TO_INT(g_object_get_data(G_OBJECT(btn), "prof_id"));

    if (!entry_nome || !entry_materia) return;

    const char *new_nome = gtk_editable_get_text(GTK_EDITABLE(entry_nome));
    const char *new_materia = gtk_editable_get_text(GTK_EDITABLE(entry_materia));

    if (strlen(new_nome) == 0 || strlen(new_materia) == 0) return;

    char caminho_temp[PATH_MAX];
    snprintf(caminho_temp, sizeof(caminho_temp), "%s.tmp", app->bdAtual);
    
    FILE *fin = fopen(app->bdAtual, "r");
    FILE *fout = fopen(caminho_temp, "w");

    if (fin && fout) {
        char linha[256];
        while (fgets(linha, sizeof(linha), fin)) {
            int id;
            if (sscanf(linha, "id: %d;", &id) == 1 && id == target_id) {
                fprintf(fout, "id: %d; nome: %s; matéria: %s;\n", target_id, new_nome, new_materia);
            } else {
                fputs(linha, fout);
            }
        }
    }
    if (fin) fclose(fin);
    if (fout) fclose(fout);

    remove(app->bdAtual);
    rename(caminho_temp, app->bdAtual);

    gtk_window_destroy(GTK_WINDOW(app->popup));
    procurarDados(app);
}

void removerArquivo(const char *path, GtkWindow *parent)
{
    struct stat st;
    if (stat(path, &st) != 0) return;

    if (S_ISDIR(st.st_mode)) {
        DIR *dir = opendir(path);
        if (!dir) return;
        struct dirent *entry;
        char sub_path[PATH_MAX];
        while ((entry = readdir(dir)) != NULL) {
            if (strcmp(entry->d_name, ".") == 0 || strcmp(entry->d_name, "..") == 0) continue;
            snprintf(sub_path, sizeof(sub_path), "%s/%s", path, entry->d_name);
            removerArquivo(sub_path, parent);
        }
        closedir(dir);
        rmdir(path);
    } else {
        remove(path);
    }
}

