void procurarBD(GtkButton *btn, gpointer data)
{
    AppData *app = data;
    g_list_free(app->checks);
    g_list_free(app->botoes);
    app->checks = NULL; app->botoes = NULL;

    if (app->label_vazio_bd != NULL) {
        gtk_overlay_remove_overlay(GTK_OVERLAY(app->overlay_bd), app->label_vazio_bd);
        app->label_vazio_bd = NULL;
    }

    GtkWidget *child;
    while ((child = gtk_widget_get_first_child(app->container_bd)) != NULL) {
        gtk_flow_box_remove(GTK_FLOW_BOX(app->container_bd), child);
    }

    DIR *d = opendir(BASE_DIR);
    if (!d) return;

    struct dirent *dir;
    gboolean encontrou = FALSE;
    while ((dir = readdir(d)) != NULL) {
        if (strcmp(dir->d_name, ".") == 0 || strcmp(dir->d_name, "..") == 0) continue;
        if (!g_str_has_suffix(dir->d_name, "_bd")) continue;

        encontrou = TRUE;
        criar_bloco_visual_bd(app, dir->d_name);
    }
    closedir(d);

    if (!encontrou) {
        app->label_vazio_bd = gtk_label_new("Nenhum banco encontrado.");
        gtk_widget_set_halign(app->label_vazio_bd, GTK_ALIGN_CENTER);
        gtk_widget_set_valign(app->label_vazio_bd, GTK_ALIGN_CENTER);
        gtk_overlay_add_overlay(GTK_OVERLAY(app->overlay_bd), app->label_vazio_bd);
    }
}

void procurarSalas(AppData *app)
{
    g_list_free(app->checks_salas);
    g_list_free(app->botoes_salas);
    app->checks_salas = NULL; app->botoes_salas = NULL;

    if (app->label_vazio_sala != NULL) {
        gtk_overlay_remove_overlay(GTK_OVERLAY(app->overlay_salas), app->label_vazio_sala);
        app->label_vazio_sala = NULL;
    }

    GtkWidget *child;
    while ((child = gtk_widget_get_first_child(app->container_salas)) != NULL) {
        gtk_flow_box_remove(GTK_FLOW_BOX(app->container_salas), child);
    }

    DIR *d = opendir(app->bdAtual);
    if (!d) return;

    struct dirent *dir;
    gboolean encontrou = FALSE;
    while ((dir = readdir(d)) != NULL) {
        if (strcmp(dir->d_name, ".") == 0 || strcmp(dir->d_name, "..") == 0) continue;
        if (!g_str_has_suffix(dir->d_name, ".txt")) continue;
        
        encontrou = TRUE;
        criar_bloco_visual_sala(app, dir->d_name);
    }
    closedir(d);

    if (!encontrou) {
        app->label_vazio_sala = gtk_label_new("Nenhum curso cadastrado.");
        gtk_widget_set_halign(app->label_vazio_sala, GTK_ALIGN_CENTER);
        gtk_widget_set_valign(app->label_vazio_sala, GTK_ALIGN_CENTER);
        gtk_overlay_add_overlay(GTK_OVERLAY(app->overlay_salas), app->label_vazio_sala);
    }
}

void procurarDados(AppData *app)
{
    GtkWidget *child;
    while ((child = gtk_widget_get_first_child(app->tabela)) != NULL) {
        gtk_grid_remove(GTK_GRID(app->tabela), child);
    }
    app->num_linhas = 0;

    g_list_free(app->checks_dados);
    g_list_free(app->botoes_dados);
    app->checks_dados = NULL; app->botoes_dados = NULL;

    if (app->label_vazio_tabela != NULL) {
        gtk_overlay_remove_overlay(GTK_OVERLAY(app->overlay_tabela), app->label_vazio_tabela);
        app->label_vazio_tabela = NULL;
    }

    FILE *f = fopen(app->bdAtual, "r");
    if (!f) return;

    const char *busca_texto = gtk_editable_get_text(GTK_EDITABLE(app->campo_busca));
    gchar *busca_lower = g_utf8_strdown(busca_texto, -1);

    char linha_txt[256];
    gboolean encontrou_dados = FALSE;
    gboolean algum_correspondeu = FALSE;

    while (fgets(linha_txt, sizeof(linha_txt), f)) {
        linha_txt[strcspn(linha_txt, "\n")] = '\0';
        if (strlen(linha_txt) == 0) continue;

        prof p;
        if (sscanf(linha_txt, "id: %d; nome: %[^;]; matéria: %[^;];", &p.IDs, p.nome, p.materia) >= 2) {
            encontrou_dados = TRUE;

            char *nome_limpo = p.nome;
            while(*nome_limpo == ' ') nome_limpo++;
            char *materia_limpa = p.materia;
            while(*materia_limpa == ' ') materia_limpa++;

            char str_id[24];
            snprintf(str_id, sizeof(str_id), "%d", p.IDs);
            gchar *nome_lower = g_utf8_strdown(nome_limpo, -1);

            gboolean termo_valido = FALSE;

            if (strlen(busca_lower) == 0) {
                termo_valido = TRUE;
            } else if (g_strrstr(nome_lower, busca_lower) != NULL || g_strrstr(str_id, busca_lower) != NULL) {
                termo_valido = TRUE;
            }

            g_free(nome_lower);

            if (termo_valido) {
                algum_correspondeu = TRUE;
                criar_bloco_visual_dado(app, p.IDs, nome_limpo, materia_limpa);
            }
        }
    }
    fclose(f);
    g_free(busca_lower);

    if (!encontrou_dados) {
        app->label_vazio_tabela = gtk_label_new("Nenhum professor cadastrado nesta sala.");
        gtk_widget_set_halign(app->label_vazio_tabela, GTK_ALIGN_CENTER);
        gtk_widget_set_valign(app->label_vazio_tabela, GTK_ALIGN_CENTER);
        gtk_overlay_add_overlay(GTK_OVERLAY(app->overlay_tabela), app->label_vazio_tabela);
    } else if (!algum_correspondeu) {
        app->label_vazio_tabela = gtk_label_new("Nenhum registro corresponde aos critérios de busca.");
        gtk_widget_set_halign(app->label_vazio_tabela, GTK_ALIGN_CENTER);
        gtk_widget_set_valign(app->label_vazio_tabela, GTK_ALIGN_CENTER);
        gtk_overlay_add_overlay(GTK_OVERLAY(app->overlay_tabela), app->label_vazio_tabela);
    }
}

