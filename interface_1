void procurarBD(GtkButton *btn, gpointer data)
{
    AppData *app = data;

    DIR *d;
    struct dirent *dir;

    g_list_free(app->checks);
    app->checks = NULL;

    g_list_free(app->botoes);
    app->botoes = NULL;

    GtkWidget *child = gtk_widget_get_first_child(app->container);

    while (child)
    {
        GtkWidget *next = gtk_widget_get_next_sibling(child);
        gtk_flow_box_remove(GTK_FLOW_BOX(app->container), child);
        child = next;
    }

    d = opendir(BASE_DIR);

    if (!d)
    {
        GtkWidget *label = gtk_label_new("Erro ao abrir diretório");
        gtk_flow_box_insert(GTK_FLOW_BOX(app->container), label, -1);
        return;
    }

    GtkWidget *label = gtk_label_new("Listando bancos...");
    gtk_flow_box_insert(GTK_FLOW_BOX(app->container), label, -1);

    while ((dir = readdir(d)) != NULL)
    {
        if (strcmp(dir->d_name, ".") != 0 &&
            strcmp(dir->d_name, "..") != 0 &&
            strstr(dir->d_name, "_bd") != NULL)
        {
            gtk_flow_box_remove(GTK_FLOW_BOX(app->container), label);
            GtkWidget *box = gtk_box_new(GTK_ORIENTATION_HORIZONTAL, 2);
            gtk_widget_set_size_request(box, 10, 10);
            gtk_widget_set_hexpand(box, FALSE);
            gtk_widget_set_vexpand(box, FALSE); 

            GtkWidget *check = gtk_check_button_new();
            gtk_widget_set_visible(check, TRUE);
            gtk_widget_set_size_request(check, 10, 10);
            gtk_widget_set_halign(check, GTK_ALIGN_END);
            gtk_widget_set_valign(check, GTK_ALIGN_START);

            char *nome = g_strdup(dir->d_name);
            g_object_set_data_full(G_OBJECT(check), "id", nome, g_free);

            GtkWidget *btn_bd = gtk_button_new_with_label(dir->d_name);
            gtk_widget_set_size_request(btn_bd, 150, 150);
            gtk_widget_set_hexpand(btn_bd, FALSE);
            gtk_widget_set_vexpand(btn_bd, FALSE);
            gtk_widget_set_halign(btn_bd, GTK_ALIGN_CENTER);
            gtk_widget_set_valign(btn_bd, GTK_ALIGN_CENTER);

            app->checks = g_list_append(app->checks, check);
            app->botoes = g_list_append(app->botoes, btn_bd);
            
            gtk_flow_box_set_selection_mode(GTK_FLOW_BOX(app->container), GTK_SELECTION_NONE);
            gtk_flow_box_set_homogeneous(GTK_FLOW_BOX(app->container), FALSE);  

            gtk_box_append(GTK_BOX(box), btn_bd);
            gtk_box_append(GTK_BOX(box), check);
            gtk_flow_box_insert(GTK_FLOW_BOX(app->container), box, -1);
        }
    }

    closedir(d);
}

void criarBD(GtkButton *btn, gpointer data)
{
    AppData *app = data;

    GtkWidget *entry = g_object_get_data(G_OBJECT(btn), "entry");

    if (!entry)
    {
        mostrar_erro(GTK_WINDOW(app->popup), "nome não renderizado, tente de novo!");
        return;
    }


    const char *texto = gtk_editable_get_text(GTK_EDITABLE(entry));

    if (!texto || strlen(texto) == 0)
    {
        mostrar_erro(GTK_WINDOW(app->popup), "Nome do banco não pode ser vazio!");
        return;
    }

    char nome[100];
    strncpy(nome, texto, sizeof(nome));
    nome[sizeof(nome) - 1] = '\0';

    for (int i = 0; nome[i]; i++)
        if (nome[i] == ' ')
            nome[i] = '_';

    char pasta[3000];
    snprintf(pasta, sizeof(pasta), "%s\\%s_bd", BASE_DIR, nome);

    struct stat st;

    if (stat(pasta, &st) == 0)
    {
        mostrar_erro(GTK_WINDOW(app->popup), "Esse banco já existe!");
        return;
    }

    if (mkdir(pasta) != 0){
        mostrar_erro(GTK_WINDOW(app->popup), "Erro ao criar banco de dados!");   
        return;
    }

    gtk_window_destroy(GTK_WINDOW(app->popup));
    app->popup = NULL;

    procurarBD(NULL,data);
}

void removerBD(const char *path, GtkWindow *parent)
{
    DIR *dir = opendir(path);
    struct dirent *entry;
    char caminho[1024];
    struct stat st;

    if (!dir)
    {
        mostrar_erro(parent, "Não foi possível abrir a pasta");
        return;
    }

    while ((entry = readdir(dir)) != NULL)
    {
        if (!strcmp(entry->d_name, ".") || !strcmp(entry->d_name, ".."))
            continue;

        snprintf(caminho, sizeof(caminho), "%s/%s", path, entry->d_name);

        if (stat(caminho, &st) == 0 && S_ISDIR(st.st_mode))
        {
            removerBD(caminho, parent);
        }
        else
        {
            if (remove(caminho) != 0)
                mostrar_erro(parent, "Erro ao remover arquivo interno");
        }
    }

    closedir(dir);

    if (rmdir(path) != 0)
        mostrar_erro(parent, "Erro ao remover pasta principal");
}

