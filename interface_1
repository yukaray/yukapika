void procuraTB(FILE* Tb_ptr)
{
    if (Tb_ptr == NULL)
    {
        printf("Erro, tabela não encontrada\n");
        return;
    }

    rewind(Tb_ptr);

    char nome_ext[100];
    char sala_ext[50];
    char materia_ext[50];
    char profAlvo[100];

    int id_ext;

    char especifico;
    char linha[256];

    printf("Procurar alguém específico? (s/n)\n");
    scanf(" %c", &especifico);

    if (especifico == 'n')
    {
        while (fgets(linha, sizeof(linha), Tb_ptr))
        {
            printf("%s", linha);
        }
    }
    else
    {
        printf("Qual professor deseja procurar?\n");

        getchar();

        fgets(profAlvo, sizeof(profAlvo), stdin);
        profAlvo[strcspn(profAlvo, "\n")] = '\0';

        while (fgets(linha, sizeof(linha), Tb_ptr))
        {
            if (sscanf(linha,
                "id: %d, nome: %99[^,], materia: %49[^,], sala: %49[^\n]",
                &id_ext,
                nome_ext,
                materia_ext,
                sala_ext) == 4)
            {
                if (strcmp(nome_ext, profAlvo) == 0)
                {
                    printf("%s", linha);
                }
            }
        }

        printf("Professor não encontrado.\n");
    }
}

void cadastroTB(FILE* Tb_ptr)
{
    struct professor prof;
    int id_novo;

    if (!Tb_ptr)
    {
        printf("Erro, tabela não encontrada\n");
        return;
    }

    printf("Coloque o nome do professor:\n");
    while (getchar() != '\n');
    fgets(prof.nome, sizeof(prof.nome), stdin);
    prof.nome[strcspn(prof.nome, "\n")] = '\0';

    printf("Coloque a matéria:\n");
    fgets(prof.materia, sizeof(prof.materia), stdin);
    prof.materia[strcspn(prof.materia, "\n")] = '\0';

    printf("Coloque a sala:\n");
    fgets(prof.sala, sizeof(prof.sala), stdin);
    prof.sala[strcspn(prof.sala, "\n")] = '\0';

    id_novo = contagem(Tb_ptr);

    fseek(Tb_ptr, 0, SEEK_END);

    fprintf(Tb_ptr,
        "id: %d, nome: %s, materia: %s, sala: %s\n",
        id_novo,
        prof.nome,
        prof.materia,
        prof.sala);

    fflush(Tb_ptr);

    printf("Professor cadastrado com sucesso!\n");
}

void abrirTB(char *filename)
{
    FILE* salas;
    char cad_pro, acabou;
    int id_alvo;

    snprintf(caminhobd_tb, sizeof(caminhobd_tb),
             "%s/%s.txt", bdAtual, filename);

    salas = fopen(caminhobd_tb, "a+");

    if (!salas) {
        printf("Erro ao abrir tabela!\n");
        return;
    }

    do
    {
        printf("cadastrar / procurar / alterar / remover o professor (c/p/a/r)\n");
        scanf(" %c", &cad_pro);

        switch (cad_pro)
        {
        case 'c':
            cadastroTB(salas);
            break;

        case 'p':
            procuraTB(salas);
            break;

        case 'a':
            alterar();
            break;

        case 'r':
            printf("ID: ");
            scanf("%d", &id_alvo);
            remover(id_alvo);
            break;
        }

        printf("Continuar? (s/n)\n");
        scanf(" %c", &acabou);

    } while (acabou == 's');

    fclose(salas);
}

