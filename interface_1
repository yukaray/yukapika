void mostrar_erro(GtkWindow *parent, const char *mensagem)
{
    GtkAlertDialog *dialog = gtk_alert_dialog_new("%s", mensagem);

    gtk_alert_dialog_show(dialog, parent);
}

void tratar_excluir(GtkButton *btn, gpointer data)
{
    AppData *app = data;

    for (GList *l = app->checks; l != NULL; l = l->next)
    {
        GtkWidget *check = l->data;

        if (gtk_check_button_get_active(GTK_CHECK_BUTTON(check)))
        {
            const char *id = g_object_get_data(G_OBJECT(check), "id");

            if (!id)
            {
                mostrar_erro(GTK_WINDOW(app->popup), "ID inválido");
                return;
            }

            char caminho[300];
            snprintf(caminho, sizeof(caminho), "%s/%s", app->bdAtual, id);

            removerBD(caminho, GTK_WINDOW(app->popup));
            return;
        }
    }

    mostrar_erro(GTK_WINDOW(app->popup), "Nenhum item selecionado");
}

void desativar_check_exc(GtkButton *btn, gpointer data)
{
    AppData *app = data;

    for (GList *l = app->checks; l != NULL; l = l->next)
        gtk_widget_set_visible(GTK_WIDGET(l->data), FALSE);
}

void ativar_check_exc(GtkButton *btn, gpointer data)
{
    AppData *app = data;

    for (GList *l = app->checks; l != NULL; l = l->next)
        gtk_widget_set_visible(GTK_WIDGET(l->data), TRUE);
}

void popup_criarBD(GtkButton *btn, gpointer data)
{
    AppData *app = data;

    GtkWidget *popup = gtk_window_new();
    app->popup = popup;

    gtk_window_set_title(GTK_WINDOW(popup), "Criar BD");
    gtk_window_set_default_size(GTK_WINDOW(popup), 300, 120);

    GtkWidget *box = gtk_box_new(GTK_ORIENTATION_VERTICAL, 10);

    GtkWidget *entry = gtk_entry_new();
    GtkWidget *btn_create = gtk_button_new_with_label("Criar");

    g_object_set_data(G_OBJECT(btn_create), "entry", entry);
    g_signal_connect(btn_create, "clicked", G_CALLBACK(criarBD), app);

    gtk_box_append(GTK_BOX(box), entry);
    gtk_box_append(GTK_BOX(box), btn_create);

    gtk_window_set_child(GTK_WINDOW(popup), box);
    gtk_window_present(GTK_WINDOW(popup));
}

static void reajustar(GtkWidget *Widget, GtkAllocation *allocation, gpointer data) {

    GtkFlowBox *flow = GTK_FLOW_BOX(data);

    int largura = allocation->width;

    int colunas = largura / 150;

    if (colunas < 1)
        colunas = 1;

    gtk_flow_box_set_max_children_per_line(flow, colunas);
}

static void interface(GtkApplication *app, gpointer user_data)
{
    AppData *data = g_malloc0(sizeof(AppData));

    /* ===== JANELA PRINCIPAL ===== */
    GtkWidget *win = gtk_application_window_new(app);
    gtk_window_set_title(GTK_WINDOW(win), "Banco de Dados");
    gtk_window_set_default_size(GTK_WINDOW(win), 1200, 900);

    /* ===== STACK (PÁGINAS) ===== */
    GtkWidget *stack = gtk_stack_new();

    /* ===== PÁGINA PRINCIPAL ===== */
    GtkWidget *pagina = gtk_box_new(GTK_ORIENTATION_VERTICAL, 10);

    /* ===== NAVBAR ===== */
    GtkWidget *nav = gtk_box_new(GTK_ORIENTATION_HORIZONTAL, 10);

    GtkWidget *btn_container = gtk_box_new(GTK_ORIENTATION_HORIZONTAL, 10);
    gtk_widget_set_hexpand(btn_container, TRUE);
    gtk_widget_set_halign(btn_container, GTK_ALIGN_END);

    /* ===== BOTÕES ===== */
    GtkWidget *btn_criar = gtk_button_new_with_label("Criar");
    GtkWidget *btn_excluir = gtk_button_new_with_label("Excluir");

    data->btn_criar = btn_criar;
    data->btn_excluir = btn_excluir;

    /* ===== CONTAINER DOS BANCOS ===== */
    GtkWidget *container = gtk_flow_box_new();

    data->container = container;

    gtk_flow_box_set_selection_mode(GTK_FLOW_BOX(container), GTK_SELECTION_NONE);
    gtk_widget_set_hexpand(container, TRUE);
    gtk_widget_set_vexpand(container, TRUE);

    /* ===== RESIZE DINÂMICO ===== */
    g_signal_connect(win, "notify::width", G_CALLBACK(reajustar), container);

    /* ===== CONEXÕES DOS BOTÕES ===== */
    g_signal_connect(btn_criar, "clicked", G_CALLBACK(popup_criarBD), data);
    g_signal_connect(btn_excluir, "clicked", G_CALLBACK(ativar_check_exc), data);

    /* ===== MONTAGEM NAV ===== */
    gtk_box_append(GTK_BOX(btn_container), btn_criar);
    gtk_box_append(GTK_BOX(btn_container), btn_excluir);

    gtk_box_append(GTK_BOX(nav), btn_container);

    /* ===== MONTAGEM PÁGINA ===== */
    gtk_box_append(GTK_BOX(pagina), nav);
    procurarBD(NULL,data);
    gtk_box_append(GTK_BOX(pagina), container);

    /* ===== STACK ===== */
    gtk_stack_add_named(GTK_STACK(stack), pagina, "menu");

    gtk_window_set_child(GTK_WINDOW(win), stack);

    gtk_window_present(GTK_WINDOW(win));
}

int main(int argc, char **argv)
{
    GtkApplication *app;
    int status;

    init_base_dir();

    app = gtk_application_new("com.exemplo.loading", G_APPLICATION_DEFAULT_FLAGS);
    g_signal_connect(app, "activate", G_CALLBACK(interface), NULL);

    status = g_application_run(G_APPLICATION(app), argc, argv);
    g_object_unref(app);

    return status;
}
