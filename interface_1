void alterar()
{
    char acabou_alterando = 'n';
    char alteracao;
    char novoDado[100];
    int id_alvo;

    do
    {
        printf("Quer alterar nome, materia ou sala? (n/m/s)\n");
        scanf(" %c", &alteracao);

        printf("Qual é o id?\n");
        scanf("%d", &id_alvo);

        while (getchar() != '\n'); // FIX BUFFER

        switch (alteracao)
        {
        case 'n':
            printf("Qual é o novo nome?\n");
            fgets(novoDado, sizeof(novoDado), stdin);
            break;

        case 'm':
            printf("Qual é a nova matéria?\n");
            fgets(novoDado, sizeof(novoDado), stdin);
            break;

        case 's':
            printf("Qual é a nova sala?\n");
            fgets(novoDado, sizeof(novoDado), stdin);
